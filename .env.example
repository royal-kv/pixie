# Copy this file to .env and fill in your values. Never commit the real .env file.

# AWS Bedrock — this uses a Bedrock API key (bearer token) against the Bedrock Runtime
# InvokeModel API, not a SigV4 access key/secret pair.
VITE_AWS_REGION=us-east-1
VITE_AWS_BEDROCK_API_KEY=your-bedrock-api-key

# Bedrock model id to use for all 4 agents. Defaults to Haiku (cheap/fast) so early wiring and
# testing doesn't burn through tokens — bump to a stronger model once the pipeline works, e.g.
# anthropic.claude-3-5-sonnet-20241022-v2:0. Check the Bedrock console for exact ids your
# account/region has access to.
VITE_BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# Set to "true" to skip live Bedrock calls entirely and serve hardcoded fixtures from
# public/fixtures/ instead (see public/fixtures/README.md). Useful for UI work / demos without
# spending tokens or needing a working Bedrock key.
VITE_USE_MOCK_DATA=false
